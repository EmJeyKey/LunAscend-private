# Keep source/report checksums stable across Windows/Linux checkouts.
backend/src/lunascend/ephemeris/*.py text eol=lf
backend/src/lunascend/terrain/*.py text eol=lf
backend/src/lunascend/visibility/*.py text eol=lf
backend/src/lunascend/power/*.py text eol=lf
backend/src/lunascend/communication/*.py text eol=lf
backend/src/lunascend/resilience/*.py text eol=lf
backend/src/lunascend/contracts/resilience.py text eol=lf
backend/src/lunascend/contracts/visualization.py text eol=lf
backend/src/lunascend/contracts/engineering.py text eol=lf
backend/src/lunascend/contracts/models.py text eol=lf
backend/src/lunascend/providers/scientific.py text eol=lf
docs/validation/* text eol=lf
# Preserve unmodified Horizons API response bytes for SHA-256 verification.
data/fixtures/horizons/*.response.json -text
# Preserve upstream font license bytes, including original whitespace.
frontend/public/fonts/*-OFL.txt -text whitespace=-blank-at-eol
frontend/public/licenses/three-LICENSE.txt -text whitespace=-blank-at-eol
# Preserve original NASA capability/FGDC bytes and their pinned checksums.
data/fixtures/imagery/*.xml -text whitespace=-blank-at-eol
data/fixtures/imagery/*.html -text whitespace=-blank-at-eol
